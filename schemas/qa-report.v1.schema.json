{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "auto-cut-slicing/schemas/qa-report.v1.schema.json",
  "title": "Auto-Cut Slicing QA report v1",
  "description": "成片内容质量检查。自动检查、AI 读图/读文本复核与人工复核分开记录；任何报告都不代表最终验收。规则见 docs/ai-editing-workflow.md。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "bindings", "overall", "checks", "limitations"],
  "properties": {
    "schema": {"const": "auto-cut-slicing/qa-report"},
    "schema_version": {"const": 1},
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent_sha256", "plan_sha256", "output_id", "output_sha256", "source_sha256s", "output_alignment_sha256"],
      "properties": {
        "intent_sha256": {"$ref": "#/$defs/sha256"},
        "plan_sha256": {"$ref": "#/$defs/sha256"},
        "output_id": {"$ref": "#/$defs/id"},
        "output_sha256": {"$ref": "#/$defs/sha256"},
        "source_sha256s": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sha256"}},
        "output_alignment_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      }
    },
    "overall": {
      "description": "failed：至少一项 failed。ready_for_review：没有 failed，但仍有 ai_reviewed / needs_human / not_run 项需要审批环节处理。没有“已验收”取值。",
      "enum": ["failed", "ready_for_review"]
    },
    "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"},
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "intent_id", "kind", "status", "method", "evidence_ids", "target_start_us", "target_end_us", "detail"],
      "properties": {
        "check_id": {"$ref": "#/$defs/id"},
        "intent_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "kind": {
          "enum": [
            "coverage_complete", "operation_compiled", "phrase_absent", "phrase_present",
            "cue_first_word", "must_keep_present", "duration_match", "cut_not_inside_word",
            "sentence_complete", "seam_gap", "seam_discontinuity", "opening_frame",
            "seam_frames", "seam_pause_picture", "freeze_frames", "mute_silence", "unlisted_change", "listening", "pacing"
          ]
        },
        "status": {"enum": ["passed", "failed", "ai_reviewed", "needs_human", "not_run"]},
        "method": {"enum": ["automatic", "ai_visual", "ai_reading", "human"]},
        "evidence_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}},
        "target_start_us": {"type": ["integer", "null"], "minimum": 0},
        "target_end_us": {"type": ["integer", "null"], "minimum": 0},
        "detail": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"enum": ["listening", "pacing"]}}},
          "then": {"properties": {"status": {"enum": ["needs_human", "not_run", "failed"]}}}
        },
        {
          "if": {"properties": {"status": {"const": "ai_reviewed"}}},
          "then": {"properties": {"method": {"enum": ["ai_visual", "ai_reading"]}}}
        }
      ]
    }
  }
}
