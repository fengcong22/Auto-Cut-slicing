{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "auto-cut-slicing/schemas/qa-review.v1.schema.json",
  "title": "Auto-Cut Slicing QA review v1",
  "description": "AI 对 qa.json 中标记 needs_human 的画面项给出的复核结论。只补充画面判断，不修改自动检查结果，也不代表试听或最终验收。见 docs/ai-editing-workflow.md。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "qa_sha256", "reviewer", "frames_sha256", "items"],
  "properties": {
    "schema": {"const": "auto-cut-slicing/qa-review"},
    "schema_version": {"const": 1},
    "qa_sha256": {
      "description": "本结论针对的 qa.json 文件字节 SHA-256；与当前报告不一致即拒绝。",
      "$ref": "#/$defs/sha256"
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent", "model"],
      "properties": {
        "agent": {"$ref": "#/$defs/id"},
        "model": {"type": "string", "minLength": 1}
      }
    },
    "frames_sha256": {
      "type": "object",
      "description": "看过的每一帧文件名到其 SHA-256；必须覆盖结论引用的全部帧。",
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "question_id", "verdict", "observation"],
        "properties": {
          "check_id": {"type": "string", "minLength": 1},
          "question_id": {"type": "string", "minLength": 1},
          "verdict": {"enum": ["clean", "defect", "unclear"]},
          "observation": {"type": "string", "minLength": 1},
          "frames": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "description": "本结论实际看过的帧文件名。"
          }
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
